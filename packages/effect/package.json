{
	"name": "@fetch-frog/effect",
	"version": "0.0.0",
	"private": false,
	"description": "Effect integration for fetch-frog",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bendingthemrules/fetch-frog",
		"directory": "packages/effect"
	},
	"files": [
		"dist/**"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "pnpm test:types && vitest run",
		"test:types": "tsc -p tsconfig.json --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt --write .",
		"fmt:check": "oxfmt --check ."
	},
	"dependencies": {
		"fetch-frog": "workspace:*",
		"ofetch": "catalog:"
	},
	"devDependencies": {
		"effect": "^4.0.4",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typescript": "^5.0.0",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	}
}
