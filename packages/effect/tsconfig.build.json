{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"inlineSources": true,
		"noEmit": false,
		"stripInternal": true,
		"newLine": "lf"
	},
	"include": ["index.ts"],
	"exclude": ["**/*.test.ts", "**/*.test-d.ts", "test/**/*", "node_modules", "dist"]
}
