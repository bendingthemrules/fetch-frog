{
	"compilerOptions": {
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"types": []
	},
	"include": ["index.ts", "use-fetch.ts", "utils.ts", "types/**/*.ts", "use-fetch.test-d.ts"],
	"exclude": ["node_modules", "playground", "**/*.test.ts"]
}
